{
  "name": "@myclis/kie",
  "version": "0.2.0",
  "description": "Zero-dependency CLI for KIE.ai media generation (images & video), built for AI agents with hard spend guards.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kie": "dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "dev": "npm run build && node dist/src/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {}
}

{
  "name": "@uxdata-co/kie",
  "version": "0.5.0",
  "description": "Zero-dependency CLI that lets AI agents generate images & video on KIE.ai with the API key locked away and hard spend guards.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kie": "dist/src/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-skill.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "npm run build && node dist/src/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julio-daza/kie-cli.git",
    "directory": "kie"
  },
  "homepage": "https://github.com/julio-daza/kie-cli#readme",
  "bugs": {
    "url": "https://github.com/julio-daza/kie-cli/issues"
  },
  "author": "Julio Daza",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "cli",
    "codex",
    "cursor",
    "gemini-cli",
    "image-generation",
    "kie",
    "kie.ai",
    "kling",
    "nano-banana",
    "veo3",
    "video-generation"
  ],
  "publishConfig": {
    "access": "public"
  }
}

---
import MaskedHeading from "./MaskedHeading";
import Terminal from "./Terminal.astro";
import { guardTerminal, heroTerminal } from "./terminals";
import { REPO, t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const installCmd = `git clone ${REPO}.git && cd kie-cli/kie && npm i && npm run build && npm link`;

const usageTabs = [
  { id: "image", label: s.usage.tabs.image, code: s.usage.image },
  { id: "video", label: s.usage.tabs.video, code: s.usage.video },
  { id: "edit", label: s.usage.tabs.edit, code: s.usage.edit },
  { id: "raw", label: s.usage.tabs.raw, code: s.usage.raw },
];
---

<!-- ============================================================ HERO -->
<section class="hero" id="top">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{s.hero.eyebrow}</p>
        <MaskedHeading
          client:load
          tag="h1"
          text={s.hero.headline}
          src="/mask.svg"
          align="left"
          weight={700}
          tracking={-0.04}
          lineHeight={1.0}
          textScale={0.105}
          reveal="rise"
          trigger="mount"
          parallax={22}
          drift={14}
          fillScale={1.3}
          className="hero-title"
        />
        <p class="lead">{s.hero.sub}</p>
        <div class="cta-row">
          <a href="#install" class="btn btn-primary">{s.hero.ctaPrimary} →</a>
          <a href="#docs" class="btn">{s.hero.ctaSecondary}</a>
        </div>
        <div class="cmd">
          <code>$ {installCmd}</code>
          <button class="copy" data-copy={installCmd} data-copied={s.hero.copied} type="button">{s.hero.copy}</button>
        </div>
      </div>
      <div class="hero-term reveal in">
        <Terminal title={s.hero.terminalTitle} html={heroTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ TRUST STRIP -->
<section class="trust">
  <div class="rails">
    <div class="grid trust-grid">
      {s.trust.map((item) => (
        <div class="stat reveal">
          <span class="num">{item.k}</span>
          <span class="lbl">{item.v}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ WHY -->
<section id="why" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.why.eyebrow}</p>
      <h2>{s.why.title}</h2>
      <p class="lead">{s.why.lead}</p>
    </div>
    <div class="grid why-grid" style="margin-top:56px">
      {s.why.cards.map((c, i) => (
        <article class="card reveal" style={`transition-delay:${i * 60}ms`}>
          <span class="idx">0{i + 1}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ INSTALL -->
<section id="install" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.install.eyebrow}</p>
        <h2>{s.install.title}</h2>
      </div>
      <ol class="steps">
        {s.install.steps.map((st, i) => (
          <li class="step reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="idx">0{i + 1}</span>
            <div>
              <h3>{st.t}</h3>
              <p class="muted" set:html={st.d.replace(/`([^`]+)`/g, "<code>$1</code>")} />
              <pre class="code"><code>{st.code}</code></pre>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- ============================================================ USAGE -->
<section id="usage" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.usage.eyebrow}</p>
      <h2>{s.usage.title}</h2>
    </div>
    <div class="usage reveal" data-tabs>
      <div class="tablist" role="tablist">
        {usageTabs.map((tab, i) => (
          <button role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? "true" : "false"} type="button">
            {tab.label}
          </button>
        ))}
      </div>
      {usageTabs.map((tab, i) => (
        <div role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
          <pre class="code big"><code>{tab.code}</code></pre>
        </div>
      ))}
      <div class="result">
        <span class="eyebrow" style="margin:0 0 12px">{s.usage.resultTitle}</span>
        <pre class="code json"><code>{`{
  "taskId": "task_c0ffee12",
  "model": "nano-banana-2",
  "state": "success",
  "creditsConsumed": 8,
  "files": ["kie-media/nano-banana-2-c0ffee12.png"]
}`}</code></pre>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ SPEND GUARD -->
<section id="guard" class="section-pad guard">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.guard.eyebrow}</p>
        <h2>{s.guard.title}</h2>
        <p class="lead">{s.guard.lead}</p>
        <div class="exit">
          <span class="eyebrow" style="margin:36px 0 12px">{s.guard.exit}</span>
          <table class="tbl">
            <tbody>
              {s.guard.codes.map(([code, desc]) => (
                <tr>
                  <td><span class:list={["code-pill", code === "3" ? "hot" : ""]}>{code}</span></td>
                  <td>{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="checks">
        {s.guard.checks.map((c, i) => (
          <div class="check reveal" style={`transition-delay:${i * 90}ms`}>
            <span class="n">{c.n}</span>
            <div>
              <h3>{c.t}</h3>
              <p class="muted">{c.d}</p>
            </div>
          </div>
        ))}
        <Terminal title="exit 3" class="reveal" html={guardTerminal} />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================ DOCS -->
<section id="docs" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="reveal">
      <p class="eyebrow">{s.docs.eyebrow}</p>
      <h2>{s.docs.title}</h2>
    </div>
    <div class="tbl-wrap reveal" style="margin-top:40px">
      <table class="tbl">
        <tbody>
          {s.docs.commands.map(([cmd, desc]) => (
            <tr><td>{cmd}</td><td>{desc}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="docs-2col">
      <div class="reveal">
        <h3 class="sub">{s.docs.flagsTitle}</h3>
        <div class="tbl-wrap">
          <table class="tbl">
            <tbody>
              {s.docs.flags.map(([flag, desc]) => (
                <tr><td>{flag}</td><td>{desc}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="reveal">
        <h3 class="sub">{s.docs.catalogTitle}</h3>
        <div class="tbl-wrap">
          <table class="tbl">
            <tbody>
              {s.docs.catalog.map(([name, kind, desc]) => (
                <tr>
                  <td>{name}</td>
                  <td><span class="tag">{kind}</span></td>
                  <td>{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <p style="margin-top:28px"><a class="more" href={`${REPO}/blob/main/kie/README.md`} target="_blank" rel="noopener">{s.docs.more} →</a></p>
  </div>
</section>

<!-- ============================================================ SKILL -->
<section id="skill" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">{s.skill.eyebrow}</p>
        <h2>{s.skill.title}</h2>
        <p class="lead">{s.skill.lead}</p>
        <pre class="code" style="margin-top:28px"><code>{s.skill.code}</code></pre>
      </div>
      <ul class="rules">
        {s.skill.rules.map((r, i) => (
          <li class="reveal" style={`transition-delay:${i * 70}ms`}><span class="chk">✓</span>{r}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============================================================ FAQ -->
<section id="faq" class="section-pad">
  <div class="rails">
    <span class="cross tl"></span><span class="cross tr"></span>
    <p class="eyebrow reveal">{s.faq.eyebrow}</p>
    <div class="faq">
      {s.faq.items.map((it) => (
        <details class="reveal">
          <summary>{it.q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ============================================================ CTA -->
<section class="cta">
  <div class="rails cta-inner">
    <span class="cross tl"></span><span class="cross tr"></span>
    <div class="cta-head">
    <MaskedHeading
      client:load
      tag="h2"
      text={s.cta.title}
      src="/mask.svg"
      align="center"
      weight={700}
      tracking={-0.04}
      lineHeight={1.02}
      textScale={0.072}
      reveal="rise"
      trigger="view"
      parallax={18}
      drift={12}
      className="cta-title"
    />
    </div>
    <p class="lead center">{s.cta.sub}</p>
    <a href={REPO} class="btn btn-brand" target="_blank" rel="noopener">{s.cta.button} →</a>
  </div>
</section>

<style>
  /* hero */
  .hero {
    border-top: 0;
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 75% -10%, rgba(0, 168, 255, 0.14), transparent 60%),
      radial-gradient(600px 400px at 10% 110%, rgba(30, 64, 216, 0.12), transparent 60%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(64px, 9vw, 128px);
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  :global(.hero-title) {
    margin: 0 0 24px !important;
    width: 100%;
  }
  .hero-copy {
    min-width: 0;
    max-width: 640px;
  }
  .hero-term {
    min-width: 0;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .cmd {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    padding: 8px 8px 8px 14px;
  }
  .cmd code {
    font-size: 12.5px;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .hero-term {
    transform: perspective(1400px) rotateY(-4deg);
    transition: transform 0.6s ease;
  }
  .hero-term:hover {
    transform: perspective(1400px) rotateY(0deg);
  }
  @media (max-width: 980px) {
    .hero-term {
      transform: none;
    }
  }

  /* trust */
  .trust-grid {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 800px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .stat {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .num {
    font-size: 40px;
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(180deg, #fff, #9ec9ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lbl {
    font-size: 14px;
    color: var(--fg-muted);
  }

  /* why */
  .why-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 900px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }

  /* install */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .step p {
    margin: 6px 0 16px;
    font-size: 15px;
  }
  .step code:not(pre code) {
    background: var(--bg-raised);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }

  /* usage */
  .usage {
    margin-top: 40px;
    border: 1px solid var(--line);
    background: var(--bg-card);
  }
  .tablist {
    display: flex;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .tablist button {
    appearance: none;
    background: transparent;
    border: 0;
    border-right: 1px solid var(--line);
    color: var(--fg-muted);
    font: 500 13.5px var(--font-sans);
    padding: 14px 20px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tablist button[aria-selected="true"] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--brand);
  }
  .usage pre.code.big {
    border: 0;
    border-radius: 0;
    font-size: 15px;
    padding: 28px 24px;
    background: transparent;
  }
  .result {
    border-top: 1px solid var(--line);
    padding: 22px 24px 24px;
  }
  .json {
    background: transparent;
    border: 0;
    padding: 0;
  }

  /* guard */
  .checks {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .check {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 8px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .check:nth-last-child(2) {
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
  }
  .check .n {
    font-family: var(--font-mono);
    color: var(--brand);
    font-size: 13px;
    padding-top: 4px;
  }
  .check p {
    margin: 6px 0 0;
    font-size: 15px;
  }
  .code-pill {
    font-family: var(--font-mono);
    display: inline-block;
    min-width: 28px;
    text-align: center;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
  }
  .code-pill.hot {
    color: var(--brand);
    border-color: rgba(0, 168, 255, 0.5);
    background: var(--brand-soft);
  }

  /* docs */
  .docs-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 48px;
  }
  @media (max-width: 900px) {
    .docs-2col {
      grid-template-columns: 1fr;
    }
  }
  .sub {
    margin-bottom: 14px;
    font-size: 16px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }
  .more {
    color: var(--brand);
    font-weight: 500;
  }

  /* skill */
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rules li {
    display: flex;
    gap: 14px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    font-size: 16px;
  }
  .rules li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .chk {
    color: var(--ok);
    font-family: var(--font-mono);
  }

  /* faq */
  .faq {
    margin-top: 8px;
    border-top: 1px solid var(--line);
    max-width: 860px;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    font-weight: 560;
    font-size: 17px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    transition: transform 0.2s ease;
  }
  details[open] .plus {
    transform: rotate(45deg);
    color: var(--brand);
  }
  details p {
    margin: -6px 0 22px;
    color: var(--fg-muted);
    max-width: 70ch;
  }

  /* cta */
  .cta {
    background:
      radial-gradient(800px 400px at 50% 120%, rgba(0, 168, 255, 0.18), transparent 65%),
      var(--bg);
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(80px, 11vw, 150px);
    gap: 8px;
  }
  .cta-head {
    width: 100%;
    max-width: 960px;
  }
  .center {
    text-align: center;
    margin-bottom: 28px;
  }
</style>

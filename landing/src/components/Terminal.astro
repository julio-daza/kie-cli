---
/** A macOS-style terminal window. Pass pre-rendered HTML in the slot. */
interface Props {
  title?: string;
  class?: string;
  html: string;
}
const { title = "terminal", class: cls = "", html } = Astro.props;
---

<div class={`term ${cls}`}>
  <div class="bar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="title">{title}</span>
  </div>
  <pre class="body" set:html={html} />
</div>

<style>
  .term {
    background: #0c0c10;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(0, 0, 0, 0.6);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    background: #111116;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }
  .r {
    background: #ff5f57;
  }
  .y {
    background: #febc2e;
  }
  .g {
    background: #28c840;
  }
  .title {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-dim);
  }
  .body {
    margin: 0;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    color: #d9d9e0;
    overflow-x: auto;
    white-space: pre;
  }
  .body :global(.p) {
    color: var(--fg-dim);
  }
  .body :global(.b) {
    color: var(--brand);
  }
  .body :global(.d) {
    color: #1e40d8;
  }
  .body :global(.ok) {
    color: var(--ok);
  }
  .body :global(.warn) {
    color: var(--warn);
  }
  .body :global(.err) {
    color: var(--err);
  }
  .body :global(.dim) {
    color: var(--fg-dim);
  }
  .body :global(.w) {
    color: #fff;
    font-weight: 600;
  }
  .body :global(.g1) {
    color: #00b0ff;
  }
  .body :global(.g2) {
    color: #0a88eb;
  }
  .body :global(.g3) {
    color: #1660de;
  }
  .body :global(.g4) {
    color: #1e40d8;
  }
</style>
